# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local env override (use committed .env._dev / .env.dev_docker / .env.prod)
.env

# Local MCP server config - holds real API keys (e.g. Linear), never commit
.mcp.json
.mcp.json.swp

# IDE
.idea/*
src/tmp/
src/metadata/

# Terraform local state/cache - contains secrets (RDS password, app secret key), never commit
deployment/.terraform/
deployment/*.tfstate
deployment/*.tfstate.*
deployment/tfplan*
deployment/*.tfvars

celerybeat-schedule
.claude/
