ENV=dev
APP_NAME=GTFS Realtime
ADMIN_EMAIL=dev@localhost
DATABASE_URL=postgresql+psycopg2://@localhost:5432/gtfs
SECRET_KEY=local-dev-secret-change-me
DEBUG=true
CELERY_BROKER_URL=redis://localhost:6379/0
POSTHOG_ENABLED=false
